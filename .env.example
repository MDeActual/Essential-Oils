# .env.example — Copy to .env for local development only.
# Never commit the actual .env file or credentials.

# Explicit runtime: development | test | staging | production
PHYTO_RUNTIME_MODE="development"

# Optional explicit storage selection: memory | database
# Development and test may use memory. Staging and production require database.
PHYTO_STORAGE_MODE="database"

# PostgreSQL connection string. Required whenever storage mode is database and
# always required for staging or production. Replace the placeholder locally.
DATABASE_URL="postgresql://user:password@localhost:5432/phytoai?schema=public"

# Authentication mode: disabled | oidc
# Development and test may use disabled. Staging and production require oidc.
PHYTO_AUTH_MODE="disabled"

# Static trusted OIDC configuration. Required when PHYTO_AUTH_MODE=oidc.
# The application does not discover or trust a JWKS URI from a token.
PHYTO_OIDC_ISSUER="https://login.microsoftonline.com/replace-tenant-id/v2.0"
PHYTO_OIDC_AUDIENCE="api://replace-application-id"
PHYTO_OIDC_JWKS_URI="https://login.microsoftonline.com/replace-tenant-id/discovery/v2.0/keys"

# Optional CORS allowlist for browser-based frontend clients.
# Comma-separated absolute origins. Paths, credentials, and query strings are rejected.
# Example: PHYTO_CORS_ALLOWED_ORIGINS="https://console.phyto.ai,http://localhost:5173"
PHYTO_CORS_ALLOWED_ORIGINS=""

# HTTP port. Defaults to 3000.
PORT="3000"
