# .env.example — Copy to .env for local development only.
# Never commit the actual .env file or credentials.

# Explicit runtime: development | test | staging | production
PHYTO_RUNTIME_MODE="development"

# Optional explicit storage selection: memory | database
# Development and test may use memory. Staging and production require database.
PHYTO_STORAGE_MODE="database"

# PostgreSQL connection string. Required whenever storage mode is database and
# always required for staging or production. Replace the placeholder locally.
DATABASE_URL="postgresql://user:password@localhost:5432/phytoai?schema=public"

# HTTP port. Defaults to 3000.
PORT="3000"
