// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Phyto.ai Persistence Layer — Phase 4
// Models: Contributor, Protocol, Challenge, Blend, OutcomeLog
//
// Architecture constraints:
//   LOCK-001: Entity shapes align with docs/DOMAIN_MODEL.md (immutable entities).
//   LOCK-002: No moat-protected algorithm output or weight matrix is stored here.
//   LOCK-003: dataOrigin and exclusionStatus are required on every Contributor row.
//   LOCK-005: Protocol.version follows semantic versioning (enforced in application layer).
//   ADR-017: Every user-owned row carries tenantId and tenant-matched relations.
//   ADR-018: Privacy records are tenant/subject scoped and fail closed at the service layer.
//
// Connection is configured via prisma.config.ts (Prisma 7 config-based approach).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataOrigin {
  REAL_CONTRIBUTOR     @map("real_contributor")
  SYNTHETIC_SIMULATION @map("synthetic_simulation")
}

enum ExclusionStatus {
  INCLUDED @map("included")
  EXCLUDED @map("excluded")
}

enum ExclusionReason {
  ADHERENCE_BELOW_THRESHOLD @map("adherence_below_threshold")
  SYNTHETIC_DATA            @map("synthetic_data")
  MANUAL_FLAG               @map("manual_flag")
  INCOMPLETE_RECORD         @map("incomplete_record")
}

enum ProtocolStatus {
  DRAFT      @map("draft")
  ACTIVE     @map("active")
  COMPLETED  @map("completed")
  DEPRECATED @map("deprecated")
}

enum ChallengeType {
  ADHERENCE    @map("adherence")
  EDUCATIONAL  @map("educational")
  EXPERIENTIAL @map("experiential")
}

enum ChallengeCompletionStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  SKIPPED   @map("skipped")
}

enum ApplicationMethod {
  TOPICAL  @map("topical")
  AROMATIC @map("aromatic")
  INTERNAL @map("internal")
}

enum BlendSafetyStatus {
  VALIDATED @map("validated")
  PENDING   @map("pending")
  REJECTED  @map("rejected")
}

enum PrivacyPurpose {
  PROTOCOL_DELIVERY       @map("protocol_delivery")
  OUTCOME_TRACKING        @map("outcome_tracking")
  SAFETY_MONITORING       @map("safety_monitoring")
  SUBJECT_EXPORT          @map("subject_export")
  SUBJECT_DELETION        @map("subject_deletion")
  DEIDENTIFIED_ANALYTICS  @map("deidentified_analytics")
}

enum PrivacyDataClassification {
  IDENTITY_REFERENCE  @map("identity_reference")
  WELLNESS_SENSITIVE  @map("wellness_sensitive")
  PROTOCOL            @map("protocol")
  OUTCOME             @map("outcome")
  CONSENT             @map("consent")
  AUDIT_METADATA      @map("audit_metadata")
}

enum PrivacyRequestStatus {
  REQUESTED  @map("requested")
  BLOCKED    @map("blocked")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

enum PrivacyAuditAction {
  CONSENT_GRANTED       @map("consent_granted")
  CONSENT_REVOKED       @map("consent_revoked")
  PURPOSE_DENIED        @map("purpose_denied")
  DELETION_REQUESTED    @map("deletion_requested")
  DELETION_BLOCKED      @map("deletion_blocked")
  DELETION_COMPLETED    @map("deletion_completed")
  EXPORT_REQUESTED      @map("export_requested")
  EXPORT_COMPLETED      @map("export_completed")
  RETENTION_EVALUATED   @map("retention_evaluated")
  LEGAL_HOLD_APPLIED    @map("legal_hold_applied")
  LEGAL_HOLD_RELEASED   @map("legal_hold_released")
}

model Contributor {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  recordId String @map("record_id")
  userId String @map("user_id")
  protocolId String @map("protocol_id")
  dataOrigin DataOrigin @map("data_origin")
  exclusionStatus ExclusionStatus @map("exclusion_status")
  exclusionReason ExclusionReason? @map("exclusion_reason")
  adherenceScore Float @map("adherence_score")
  challengeCompletionRate Float @map("challenge_completion_rate")
  outcomeNotes String? @map("outcome_notes")
  recordedAt DateTime @map("recorded_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  outcomeLogs OutcomeLog[]

  @@unique([tenantId, recordId])
  @@index([tenantId, protocolId])
  @@index([tenantId, dataOrigin, exclusionStatus])
  @@map("contributors")
}

model Protocol {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  protocolId String @map("protocol_id")
  version String
  userProfileId String @map("user_profile_id")
  goal String
  durationDays Int @map("duration_days")
  status ProtocolStatus @default(DRAFT)
  phases Json
  challengeIds String[] @map("challenge_ids")
  createdAt DateTime @map("created_at")
  dbCreatedAt DateTime @default(now()) @map("db_created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  challenges Challenge[]

  @@unique([tenantId, protocolId])
  @@index([tenantId, userProfileId])
  @@index([tenantId, status])
  @@map("protocols")
}

model Challenge {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  challengeId String @map("challenge_id")
  protocolId String @map("protocol_id")
  type ChallengeType
  prompt String
  dueDay Int @map("due_day")
  completionStatus ChallengeCompletionStatus @default(PENDING) @map("completion_status")
  response String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  protocol Protocol @relation(fields: [tenantId, protocolId], references: [tenantId, protocolId])

  @@unique([tenantId, challengeId])
  @@index([tenantId, protocolId])
  @@index([tenantId, completionStatus])
  @@map("challenges")
}

model Blend {
  id String @id @default(cuid())
  blendId String @unique @map("blend_id")
  oils Json
  synergyScore Float @map("synergy_score")
  applicationMethod ApplicationMethod @map("application_method")
  intendedEffect String @map("intended_effect")
  safetyStatus BlendSafetyStatus @default(PENDING) @map("safety_status")
  createdAt DateTime @map("created_at")
  lastReviewedAt DateTime @map("last_reviewed_at")
  dbCreatedAt DateTime @default(now()) @map("db_created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([safetyStatus])
  @@map("blends")
}

model OutcomeLog {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  contributorId String @map("contributor_id")
  protocolId String @map("protocol_id")
  notes String
  loggedAt DateTime @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")

  contributor Contributor @relation(fields: [tenantId, contributorId], references: [tenantId, recordId])

  @@unique([tenantId, id])
  @@index([tenantId, contributorId])
  @@index([tenantId, protocolId])
  @@map("outcome_logs")
}

model ConsentGrant {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  subjectId String @map("subject_id")
  purpose PrivacyPurpose
  noticeVersion String @map("notice_version")
  grantedAt DateTime @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, subjectId, purpose, noticeVersion, grantedAt])
  @@index([tenantId, subjectId, purpose])
  @@index([tenantId, subjectId, revokedAt, expiresAt])
  @@map("consent_grants")
}

model RetentionPolicy {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  classification PrivacyDataClassification
  retentionDays Int @map("retention_days")
  policyVersion String @map("policy_version")
  active Boolean @default(true)
  effectiveAt DateTime @map("effective_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, classification, policyVersion])
  @@index([tenantId, classification, active, effectiveAt])
  @@map("retention_policies")
}

model LegalHold {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  subjectId String @map("subject_id")
  holdRef String @map("hold_ref")
  active Boolean @default(true)
  startsAt DateTime @map("starts_at")
  endsAt DateTime? @map("ends_at")
  reasonCode String @map("reason_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, holdRef])
  @@index([tenantId, subjectId, active, startsAt, endsAt])
  @@map("legal_holds")
}

model DeletionRequest {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  subjectId String @map("subject_id")
  requestId String @map("request_id")
  status PrivacyRequestStatus @default(REQUESTED)
  requestedAt DateTime @map("requested_at")
  completedAt DateTime? @map("completed_at")
  decisionCode String? @map("decision_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, requestId])
  @@index([tenantId, subjectId, requestedAt])
  @@map("deletion_requests")
}

model ExportRequest {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  subjectId String @map("subject_id")
  requestId String @map("request_id")
  status PrivacyRequestStatus @default(REQUESTED)
  requestedAt DateTime @map("requested_at")
  completedAt DateTime? @map("completed_at")
  recordCount Int? @map("record_count")
  payloadBytes Int? @map("payload_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, requestId])
  @@index([tenantId, subjectId, requestedAt])
  @@map("export_requests")
}

model PrivacyAuditEvent {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  subjectId String? @map("subject_id")
  action PrivacyAuditAction
  decisionCode String @map("decision_code")
  policyRef String? @map("policy_ref")
  requestRef String? @map("request_ref")
  occurredAt DateTime @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, subjectId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@map("privacy_audit_events")
}
